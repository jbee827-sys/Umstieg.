# VORLAGE – hier NICHTS eintragen.
#
# Echte Schluessel gehoeren in den Tresor ausserhalb des Repos:
#   E:\jbeer\.secrets\umstieg.env
# Begruendung und Konvention stehen dort in README.md. Der Ordner liegt
# ausserhalb jedes Projektordners, damit kein `git add` ihn erfassen kann.
#
# Lokal starten (Git Bash, aus backend/):
#   npx tsx watch --env-file="E:/jbeer/.secrets/umstieg.env" src/server.ts
#
# Produktion holt die Werte nicht aus einer Datei, sondern aus Fly:
#   flyctl secrets set DB_CLIENT_ID=... DB_CLIENT_SECRET=...

# DB API Marketplace (https://developers.deutschebahn.com) – Registrierung
# erforderlich. Alle APIs muessen auf DERSELBEN Anwendung abonniert sein,
# weil das Backend ein einziges Schluesselpaar fuer alle Aufrufe nutzt.
# Benoetigt: RIS::Stations, Timetables, FaSta. Ohne diese Schluessel laeuft
# die App im degradierten Modus (keine Bahnhofssuche/Live-Daten).
DB_CLIENT_ID=
DB_CLIENT_SECRET=

# Overpass-Instanzen (oeffentlich, fair nutzen – Backend cached Graphen 24 h)
OVERPASS_URL_PRIMARY=https://overpass-api.de/api/interpreter
OVERPASS_URL_FALLBACK=https://overpass.kumi.systems/api/interpreter

PORT=3001
